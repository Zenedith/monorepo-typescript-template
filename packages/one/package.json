{
  "name": "@project/one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist/**"
  ],
  "dependencies": {
    "@ladjs/graceful": "^5.0.0",
    "@project/core": "workspace:*",
    "express": "5.1.0",
    "@matteodisabatino/express-prometheus-middleware": "6.1.0",
    "graphql": "16.12.0",
    "graphql-http": "1.22.4",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-ws": "6.0.6",
    "ioredis": "5.8.2",
    "mongodb": "^7.0.0",
    "morgan": "1.10.1",
    "uuid": "13.0.0",
    "pm2": "6.0.13",
    "ruru": "2.0.0-rc.1",
    "ws": "8.18.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.pkg.json && node ../../scripts/build.cjs .",
    "test": "jest",
    "ncu": "ncu -u",
    "tsc:check": "tsc --noEmit -p tsconfig.pkg.json",
    "tsc:watch": "tsc -w -p tsconfig.pkg.json",
    "tsx": "tsx watch src/server.ts",
    "start:node": "node dist/server.js",
    "start:watch": "nodemon --watch dist dist/server.js",
    "start:dev": "concurrently --kill-others \"tsc -w -p tsconfig.pkg.json  && node ./dist.js\" \"nodemon --watch dist dist/server.js\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier  \"!**/*.{html,json}\" --write ."
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/morgan": "1.9.10",
    "@types/node-uuid": "0.0.32",
    "@types/ws": "8.18.1",
    "typescript": "^5.9.3"
  }
}
