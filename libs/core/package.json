{
  "name": "@project/core",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*",
      "types": "./dist/*"
    }
  },
  "description": "",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.pkg.json",
    "tsc:check": "tsc --noEmit -p tsconfig.pkg.json",
    "tsc:watch": "tsc -w -p tsconfig.pkg.json",
    "test": "jest",
    "ncu": "ncu -u",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier  \"!**/*.{html,json}\" --write ."
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "1.5.0",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.1.2",
    "domhandler": "5.0.3",
    "ioredis": "5.8.2",
    "opossum": "9.0.0",
    "pino": "^10.1.0",
    "pino-elasticsearch": "8.1.0",
    "pino-loki": "2.6.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "15.1.3",
    "puppeteer": "^24.31.0",
    "slugify": "1.6.6"
  },
  "devDependencies": {
    "@types/opossum": "8.1.9",
    "typescript": "^5.9.3"
  },
  "author": "",
  "license": "ISC"
}
