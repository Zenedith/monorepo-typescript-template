{
  "exclude": ["**/*.test.ts","**/__tests__/**/*.ts", "**/*.spec.ts", "**/*.test.ts", "**/*.stub.ts", "node_modules", "dist"],
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "importsNotUsedAsValues": "remove",
    "paths": {
      "@project/*": ["./libs/*/"]
    }
  }
}
