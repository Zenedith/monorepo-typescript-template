{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r --sequential build",
    "lint": "eslint --ignore-pattern '**/dist/*'",
    "lint:fix": "eslint --fix --ignore-pattern '**/dist/*'",
    "lint:all": "pnpm -r lint",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "ncu": "ncu -u && pnpm -r ncu",
    "format": "prettier  \"!**/*.{html,json}\" --write ."
  },
  "workspaces": [
    "./libs/*",
    "./packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.21.0",
    "eslint": "9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "npm-check-updates": "^19.1.2",
    "prettier": "^3.6.2",
    "proxy-from-env": "1.1.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "dependencies": {
    "pm2": "6.0.13"
  }
}